{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Tokyo",
  "minimumReleaseAge": "2 days",
  "labels": ["dependencies", "renovate"],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true,
      "platformAutomerge": false,
      "ignoreTests": false,
      "addLabels": ["auto-merge-candidate"]
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "addLabels": ["manual-review", "major-update"]
    },
    {
      "description": "mise releases almost daily; batch updates into one weekly PR on a release at least a week old. mise-lock CI refreshes the installer checksums in a follow-up commit; merge manually after it lands",
      "matchDepNames": ["jdx/mise"],
      "schedule": ["* 0-8 * * 1"],
      "minimumReleaseAge": "7 days",
      "automerge": false,
      "addLabels": ["manual-review"]
    },
    {
      "description": "kubectl is pinned to a minor (pkgs.k8s.io repo paths are per-minor); collapse stable releases to major.minor so patch releases never rewrite the pin",
      "matchDepNames": ["kubernetes/kubernetes"],
      "extractVersion": "^v?(?<version>\\d+\\.\\d+)\\.\\d+$"
    },
    {
      "description": "OpenTofu tags can precede release assets; only update to published GitHub releases",
      "matchManagers": ["mise"],
      "matchDepNames": ["aqua:opentofu/opentofu"],
      "overrideDatasource": "github-releases"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)\\.chezmoiscripts/.*\\.sh(\\.tmpl)?$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\nreadonly \\w+=\"\\$\\{\\w+:-(?<currentValue>[^}]+)\\}\""
      ],
      "extractVersionTemplate": "^v?(?<version>.+)$",
      "versioningTemplate": "semver-coerced"
    }
  ]
}
